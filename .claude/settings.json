{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
   "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm create:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm tsc --onEmit *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm vitest run *)",

      "Bash(npx:*)",
      "Bash(ncu:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",

      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",

      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",

      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(tree *)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(git config:*)",
      "Bash(git switch *)",
      "Bash(git mv *)",
      "Bash(git reverse-parse *)",
      "Bash(git show *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * show *)",
      "Bash(git -C * status)", 

      "TodoWrite"
    ],
    "deny": ["Read(./.env*)", "Write(./.env*)", "Edit(./.env*)"]
  },
  "env": {
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "60000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4-6"
  }
}
